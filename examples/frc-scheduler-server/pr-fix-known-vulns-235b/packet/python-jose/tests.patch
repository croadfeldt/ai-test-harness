+    token = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIn0.uQo2WdSn8yLr0vR3UkKKRfE49cPw1yUx0O7uNQ3q9iA'
+    with pytest.raises(JWKError, match='asymmetric key or x509 certificate'):
