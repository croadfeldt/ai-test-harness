+"""Generated by ai-test-harness (agent mode) for python-jose 3.4.0 (category: cve, issue CVE-2024-33664).
+Candidate tests: not yet human-reviewed. Provenance in ../manifest.json."""
+import base64
+import json
+import zlib
+import pytest
+from jose import jwe
+from jose.exceptions import JWEError
+
+def _b64url(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b'=').decode('ascii')
+
+def _make_bomb_jwe() -> str:
+    """Build a valid dir/A256GCM JWE whose zip=DEF payload decompresses past the limit."""
+    key = b'0123456789abcdef0123456789abcdef'
+    header = {'alg': 'dir', 'enc': 'A256GCM', 'zip': 'DEF'}
+    encoded_header = _b64url(json.dumps(header).encode('utf-8'))
+    aad = encoded_header.encode('ascii')
+    compressed = zlib.compress(b'A' * (300 * 1024))
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+    nonce = b'\x00' * 12
+    ct = AESGCM(key).encrypt(nonce, compressed, aad)
+    cipher_text, auth_tag = (ct[:-16], ct[-16:])
+    return '.'.join([encoded_header, '', _b64url(nonce), _b64url(cipher_text), _b64url(auth_tag)])
+
+def test_ghsa_cjwg_qfpm_7377_fix_pinning():
+    """jwe.decrypt must reject a compressed JWE whose plaintext exceeds the size limit."""
+    token = _make_bomb_jwe()
+    with pytest.raises(JWEError):
+        jwe.decrypt(token, b'0123456789abcdef0123456789abcdef')
+
+def test_ghsa_cjwg_qfpm_7377_exposure():
+    """App-style jwe.decrypt call on a bomb token must raise JWEError, not consume resources."""
+    token = _make_bomb_jwe()
+    with pytest.raises(JWEError):
+        jwe.decrypt(token, '0123456789abcdef0123456789abcdef')
