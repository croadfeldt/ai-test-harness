# The harness as a container image, for the Tekton pipeline. One image runs every stage; the execute
# task runs it as the sandbox pod itself (deny-all network, no service-account token, read-only root).
# The Go toolchain rides along so a Go target goes through the same pipeline: the module cache is
# prefetched by the networked stages onto the shared workspace, and the sealed execute pod builds and
# runs the tests from it with GOPROXY off.
FROM docker.io/library/golang:1.25-bookworm AS go

FROM docker.io/library/python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local GOFLAGS=-modcacherw
WORKDIR /opt/harness
COPY pyproject.toml README.md ./
COPY src ./src
# The go/ast helper is built here, once, so no pod builds it and the read-only root never needs to.
RUN cd src/harness/adapters/gohelper && GOCACHE=/tmp/gocache go build -o /usr/local/bin/gohelper . && rm -rf /tmp/gocache
RUN pip install --no-cache-dir . && harness --version && go version && gohelper 2>&1 | head -1 || true
# The UDLM checkout for sealing records is mounted or cloned at run time ([udlm].repo); not baked in.
ENV HARNESS_SANDBOX_TARGET=pod HARNESS_GOHELPER=/usr/local/bin/gohelper
ENTRYPOINT ["harness"]
